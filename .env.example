# PostgreSQL database name used by the local Compose stack.
POSTGRES_DB=slotly
# PostgreSQL application user used locally.
POSTGRES_USER=slotly
# Development-only PostgreSQL password; replace it in your untracked .env file.
POSTGRES_PASSWORD=slotly_local_only
# Host port exposed by PostgreSQL.
POSTGRES_PORT=5433

# Host port exposed by the API container.
API_PORT=8080
# Host port exposed by the Slotly web application.
WEB_PORT=3000
# API target used by the Vite development proxy (not needed by the nginx image).
VITE_API_PROXY_TARGET=http://localhost:8080
# Host port exposed by Mailpit's SMTP listener.
SMTP_PORT=1025
# Host port exposed by Mailpit's web interface.
MAILPIT_HTTP_PORT=8025
# SMTP host and container port used by the API (Mailpit defaults shown).
SMTP_HOST=mailpit
SMTP_CONTAINER_PORT=1025
# Enable TLS and provide credentials when using an authenticated SMTP provider.
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender identity for notification emails.
SMTP_FROM_ADDRESS=notifications@slotly.local
SMTP_FROM_NAME=Slotly

# Minutes before unpaid Pending bookings expire and retention for processed job data.
PENDING_BOOKING_EXPIRY_MINUTES=15
BACKGROUND_JOB_RETENTION_DAYS=30

# Stripe test-mode API key from https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=
# Webhook signing secret printed by `stripe listen` (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
# Browser destinations used after Stripe Checkout.
STRIPE_SUCCESS_URL=http://localhost:8080/payments/success
STRIPE_CANCEL_URL=http://localhost:8080/payments/cancel

# Optional Redis-backed HybridCache L2; set to redis:6379 with the redis Compose profile.
REDIS_CONNECTION_STRING=
REDIS_PORT=6379

# Exact browser origins permitted by CORS (no wildcard origins are used).
CORS_ORIGIN_1=http://localhost:5000
CORS_ORIGIN_2=https://localhost:5001
# Optional third browser origin when calling the API directly outside the nginx proxy.
CORS_ORIGIN_3=http://localhost:3000
# Optional Seq profile settings; set SEQ_URL=http://seq:5341 when enabled.
SEQ_URL=
SEQ_HTTP_PORT=8081
SEQ_INGEST_PORT=5341

# Development-only JWT signing key (at least 32 characters); use a unique secret outside local development.
JWT_SIGNING_KEY=slotly-local-jwt-signing-key-change-before-deployment-2026
# JWT issuer and audience validated by the API.
JWT_ISSUER=slotly-api
JWT_AUDIENCE=slotly-clients
# Access-token lifetime in minutes and refresh-token lifetime in days.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Base domain used when resolving tenants from subdomains.
TENANCY_BASE_DOMAIN=slotly.local
# Enable tenant resolution from subdomains and X-Tenant/X-Tenant-Id headers.
TENANCY_ENABLE_SUBDOMAIN_RESOLUTION=true
TENANCY_ENABLE_HEADER_RESOLUTION=true

# Tenant rate limits per minute (adjust for load testing or high traffic)
RATE_LIMIT_TENANT_API=120
RATE_LIMIT_TENANT_WRITE=80
