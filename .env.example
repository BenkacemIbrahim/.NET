# Docker Compose project and ASP.NET Core host.
COMPOSE_PROJECT_NAME=slotly
ASPNETCORE_ENVIRONMENT=Development
ALLOWED_HOSTS=localhost;127.0.0.1;api

# PostgreSQL container identity and host exposure. Generate unique credentials locally.
POSTGRES_DB=slotly_example
POSTGRES_USER=slotly_example_user
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_HOST=postgres
POSTGRES_CONTAINER_PORT=5432
POSTGRES_PORT=5433
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=slotly_example;Username=slotly_example_user;Password=replace-with-a-random-local-password

# Public API/web URLs and host ports.
API_PORT=8080
WEB_PORT=3000
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

# Mailpit SMTP and browser UI.
SMTP_HOST=mailpit
SMTP_CONTAINER_PORT=1025
SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=notifications@slotly.local
SMTP_FROM_NAME=Slotly

# Hangfire scheduling, expiry, and retention.
PENDING_BOOKING_EXPIRY_MINUTES=15
BACKGROUND_JOB_RETENTION_DAYS=30
HANGFIRE_WORKER_COUNT=4
HANGFIRE_SCHEMA=hangfire

# Stripe test mode. Leave blank until real test credentials are available.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel

# Redis HybridCache and Seq structured logging.
REDIS_CONNECTION_STRING=redis:6379
REDIS_PORT=6379
SEQ_URL=http://seq:5341
SEQ_HTTP_PORT=8081
SEQ_INGEST_PORT=5341
LOG_LEVEL=Information

# JWT authentication. Generate a unique key with at least 32 characters locally.
JWT_SIGNING_KEY=replace-with-a-cryptographically-random-signing-key
JWT_ISSUER=https://slotly.local/api
JWT_AUDIENCE=https://slotly.local/web
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Tenant resolution and exact allowed browser origins.
TENANCY_BASE_DOMAIN=slotly.local
TENANCY_ENABLE_SUBDOMAIN_RESOLUTION=true
TENANCY_ENABLE_HEADER_RESOLUTION=true
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://127.0.0.1:3000

# Per-minute request limits.
RATE_LIMIT_AUTH=30
RATE_LIMIT_TENANT_API=120
RATE_LIMIT_TENANT_WRITE=80

# Explicit startup behavior; no implicit Development fallback is used.
DATABASE_AUTO_MIGRATE_AND_SEED=true
SWAGGER_ENABLED=true
