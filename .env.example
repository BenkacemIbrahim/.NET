# PostgreSQL database name used by the local Compose stack.
POSTGRES_DB=slotly
# PostgreSQL application user used locally.
POSTGRES_USER=slotly
# Development-only PostgreSQL password; replace it in your untracked .env file.
POSTGRES_PASSWORD=slotly_local_only
# Host port exposed by PostgreSQL.
POSTGRES_PORT=5433

# Host port exposed by the API container.
API_PORT=8080
# Host port exposed by Mailpit's SMTP listener.
SMTP_PORT=1025
# Host port exposed by Mailpit's web interface.
MAILPIT_HTTP_PORT=8025
