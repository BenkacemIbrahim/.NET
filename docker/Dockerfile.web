FROM node:22-alpine AS build
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /app
COPY src/slotly-web/package.json src/slotly-web/package-lock.json ./
RUN npm ci
COPY src/slotly-web/ ./
RUN test -n "$VITE_API_URL" || (echo "VITE_API_URL build argument is required" >&2; exit 1) \
    && npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS final
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
