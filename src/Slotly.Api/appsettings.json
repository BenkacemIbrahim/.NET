{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5000", "https://localhost:5001"]
  },
  "Seq": {
    "Url": ""
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "notifications@slotly.local",
    "FromName": "Slotly"
  },
  "BackgroundJobs": {
    "PendingBookingExpiryMinutes": 15,
    "RetentionDays": 30
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "SuccessUrl": "http://localhost:8080/payments/success",
    "CancelUrl": "http://localhost:8080/payments/cancel"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
